{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --env-file ../../.env",
    "build": "nest build",
    "start": "node dist/main",
    "generate:openapi": "node --env-file=../../.env dist/src/generate-openapi.js",
    "generate:openapi:build": "nest build && node --env-file=../../.env dist/src/generate-openapi.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config ../../vitest.integration.config.ts --reporter=verbose",
    "test:arch": "vitest run --config vitest.arch.config.ts"
  },
  "dependencies": {
    "@casl/ability": "^6.7.0",
    "@modubiz/config": "workspace:*",
    "@modubiz/contracts": "workspace:*",
    "@modubiz/db": "workspace:*",
    "@modubiz/i18n": "workspace:*",
    "@modubiz/money": "workspace:*",
    "@nestjs/common": "11.0.3",
    "@nestjs/core": "11.0.3",
    "@nestjs/event-emitter": "^2.1.0",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.3",
    "@nestjs/platform-fastify": "11.0.3",
    "@nestjs/swagger": "11.4.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "argon2": "^0.41.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.3.2",
    "nestjs-zod": "5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@modubiz/eslint-config": "workspace:*",
    "@modubiz/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.3",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.0.3",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
