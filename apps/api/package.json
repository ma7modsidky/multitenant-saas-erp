    "@nestjs/cli": "11.0.3",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.0.3",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
