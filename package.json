{
  "name": "modubiz",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant, modular SaaS platform for SMBs",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:arch": "npx depcruise --validate .dependency-cruiser.js apps packages",
    "test:isolation": "npx vitest run --config vitest.isolation.config.ts",
    "test:e2e": "turbo test:e2e",
    "e2e:seed": "node scripts/seed-e2e-env.mjs",
    "test:e2e:journeys": "pnpm --filter web run test:e2e:journeys",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @modubiz/db run migrate",
    "db:seed": "pnpm --filter @modubiz/db run seed",
    "generate:module": "pnpm --filter @modubiz/generator-module run generate",
    "generate:api-client": "pnpm --filter api run generate:openapi:build && pnpm --filter @modubiz/api-client run generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@modubiz/config": "workspace:*",
    "@modubiz/eslint-config": "workspace:*",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.2.0",
    "drizzle-orm": "0.45.2",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postgres": "^3.4.5",
    "prettier": "^3.3.3",
    "reflect-metadata": "^0.2.2",
    "testcontainers": "^12.0.4",
    "turbo": "^2.10.9",
    "vitest": "^4.1.10"
  }
}
