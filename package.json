{
  "name": "modubiz",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant, modular SaaS platform for SMBs",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:arch": "npx depcruise --validate .dependency-cruiser.js apps packages",
    "test:isolation": "npx vitest run --project isolation",
    "test:e2e": "turbo test:e2e",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @modubiz/db run migrate",
    "db:seed": "pnpm --filter @modubiz/db run seed",
    "generate:module": "pnpm --filter @modubiz/generator-module run generate",
    "generate:api-client": "pnpm --filter @modubiz/api-client run generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@vitest/coverage-v8": "^2.1.8",
    "dependency-cruiser": "^16.8.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
