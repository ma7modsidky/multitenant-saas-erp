# ═══════════════════════════════════════════════════════════════════════════════
# ModuBiz — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values.
# The application validates ALL variables at boot and WILL REFUSE TO START
# if validation fails.
#
# Rules:
# - Never commit a real .env file
# - Keep .env.example in sync with packages/config/src/config.schema.ts
# - Only genuinely public values may use the NEXT_PUBLIC_ prefix
# - Secrets are injected by the platform, never baked into images
#
# @see TECH_STACK.md §5 — Environment variables
# @see packages/config/src/config.schema.ts — Zod validation schema
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
# The app connects as the non-owner `modubiz_app` role so RLS is enforced.
# Migration runner uses DATABASE_MIGRATION_URL as the owner role.
DATABASE_URL=postgres://modubiz_app:modubiz_app_password@localhost:5432/modubiz
DATABASE_MIGRATION_URL=postgres://modubiz_owner:modubiz_owner_password@localhost:5432/modubiz
DATABASE_POOL_MAX=10

# ─── Redis ──────────────────────────────────────────────────────────────────
# Used for caching (ioredis) and BullMQ job queues.
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────
# Both secrets must be at least 32 characters each.
# They should be distinct from each other.
JWT_ACCESS_SECRET=your-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Stripe (Billing) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ─── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# ─── File Storage (Cloudflare R2) ──────────────────────────────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=modubiz-uploads

# ─── FX Rates ───────────────────────────────────────────────────────────────
# Provider for daily exchange rate snapshots.
FX_RATES_PROVIDER_URL=https://api.frankfurter.app
FX_RATES_API_KEY=your-fx-rates-api-key

# ─── Observability ──────────────────────────────────────────────────────────
# Sentry DSN (only required in production)
SENTRY_DSN=
# OpenTelemetry OTLP endpoint (only required in production)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Logging ────────────────────────────────────────────────────────────────
# Valid levels: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Locale / i18n ──────────────────────────────────────────────────────────
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar,fr,es
TRIAL_DURATION_DAYS=14

# ═══════════════════════════════════════════════════════════════════════════════
# Frontend (apps/web)
# ═══════════════════════════════════════════════════════════════════════════════
# These are public values exposed to the browser via NEXT_PUBLIC_ prefix.
# Only genuinely public values may use this prefix.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
